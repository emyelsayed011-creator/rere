# Copy this file to ".env" (same folder as docker-compose.yml) and fill in values.
# docker compose reads .env automatically. NEVER commit the real .env.

# --- Image publishing (docker compose build/push) ---------------------------
REGISTRY=samsary
TAG=latest

# --- Database ---------------------------------------------------------------
POSTGRES_DB=samsary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<choose-a-strong-password>

# --- JWT (REQUIRED) ---------------------------------------------------------
# Must be a long random string (>= 32 chars). Generate one:
#   PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
#   Linux/Mac:   openssl rand -base64 48
JWT_SIGNING_KEY=<generate-a-random-64-char-string>

# --- Seeded admin account (REQUIRED) ----------------------------------------
SEED_ADMIN_EMAIL=admin@samsary.local
SEED_ADMIN_PASSWORD=<choose-a-strong-password>

# --- Cloudinary (media uploads) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASSWORD=<your-app-password>          # Gmail: use App Password, not your real password
EMAIL_FROM_ADDRESS=<your-email@gmail.com>    # same as EMAIL_USER for Gmail
EMAIL_FROM_NAME=Samsarly

# --- App URL (used in email links) -----------------------------------------
# Set to your real domain when deploying to production
APP_BASE_URL=http://localhost:8080

# --- SMS (Twilio) — optional ------------------------------------------------
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# --- Seq API key — optional (leave blank for open access on private servers) -
SEQ_API_KEY=
