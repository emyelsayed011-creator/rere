# Copy this file to ".env" (same folder as docker-compose.yml) and fill in values.
# docker compose reads .env automatically. NEVER commit the real .env.

# --- Image publishing (docker compose build/push) ---------------------------
# REGISTRY is the image namespace/registry, e.g. "ghcr.io/youruser" or a Docker Hub user.
# Then:  docker compose build   &&   docker compose push
REGISTRY=samsary
TAG=latest

# --- Database ---------------------------------------------------------------
POSTGRES_DB=samsary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# --- JWT (REQUIRED) ---------------------------------------------------------
# Must be a long random string (>= 32 chars). Example to generate one:
#   PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SIGNING_KEY=replace-with-a-long-random-secret-key

# --- Seeded admin account (REQUIRED) ---------------------------------------
SEED_ADMIN_EMAIL=admin@samsary.local
SEED_ADMIN_PASSWORD=Change-Me-123!

# --- Cloudinary (media uploads) --------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_USER=
EMAIL_PASSWORD=

# --- SMS (Twilio) -----------------------------------------------------------
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
